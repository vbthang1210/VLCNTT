HOST=127.0.0.1
PORT=8000
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
DEVICE_ID=esp32_01
PUBLIC_BASE_URL=http://127.0.0.1:8000
AUDIO_STORAGE_PATH=storage/audio
METADATA_PATH=storage/metadata.json
MAX_AUDIO_SIZE=20971520
RECORDING_DEFAULT_SECONDS=5
RECORDING_MAX_SECONDS=60
RECORDING_SESSION_TIMEOUT_SECONDS=15
CORS_ORIGIN=*

# TTS_PROVIDER=edge uses the free Edge TTS service; TTS_VOICE is an Edge voice name.
# TTS_PROVIDER=openai_compatible uses an OpenAI-compatible /audio/speech endpoint.
# TTS_PROVIDER=elevenlabs uses /v1/text-to-speech/{voice_id} with xi-api-key.
TTS_PROVIDER=
TTS_API_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_RESPONSE_FORMAT=mp3

# CLOUD_PROVIDER=firestore persists light metadata/status only; audio stays local.
CLOUD_PROVIDER=
CLOUD_PROJECT_ID=
CLOUD_ACCESS_TOKEN=
CLOUD_COLLECTION=audio_metadata

# NOTIFICATION_PROVIDER=fcm sends MQTT events/errors/offline status through FCM HTTP v1.
NOTIFICATION_PROVIDER=
NOTIFICATION_PROJECT_ID=
NOTIFICATION_ACCESS_TOKEN=
NOTIFICATION_DEVICE_TOKEN=
